{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-simples",
  "account_id": "4a1961760bc2292fab3733dc2b3c811c",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Front (React + Vite) servido como static assets na mesma origem da API.
  // /api/* sempre passa pelo Worker; o resto cai no SPA (index.html).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Recursos da conta "Thales Laray" (criados com o cf em 2026-10-28).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm-simples",
      "database_id": "6b799034-10bc-405a-9470-8a2033e13b6e",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "crm-simples-media" }],

  "queues": {
    "producers": [{ "binding": "MEDIA_QUEUE", "queue": "crm-simples-media" }],
    "consumers": [
      {
        "queue": "crm-simples-media",
        "max_retries": 5,
        "dead_letter_queue": "crm-simples-media-dlq"
      }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "INBOX_HUB", "class_name": "InboxHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxHub"] }],

  "triggers": { "crons": ["*/5 * * * *"] },

  "observability": { "enabled": true }
}
